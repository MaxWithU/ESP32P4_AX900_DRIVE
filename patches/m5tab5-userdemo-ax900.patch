+void Ax900TestView::update(const ax900_link_status_t &s) {
+    unsigned mode=lv_dropdown_get_selected(_mode);
+    if(_lastMode!=mode){_startError=ESP_OK;_lastMode=mode;}
+    bool active=s.connecting || s.associated;
+    lv_label_set_text(_ssid,active && s.connected_ssid[0]?s.connected_ssid:"No network");
+    if(active && s.connected_frequency) {
+        unsigned channel=s.connected_frequency>5000?(s.connected_frequency-5000)/5:(s.connected_frequency-2407)/5;
+        lv_label_set_text_fmt(_band,"%s   /   CH %u   /   %u MHz",s.connected_frequency>5000?"5 GHz":"2.4 GHz",channel,s.connected_frequency);
+    } else lv_label_set_text(_band,"Select a network to connect");
+    bool complete[]={s.ready,s.associated,s.authenticated,s.has_ip};
+    for(unsigned i=0;i<4;i++) {
+        bool busy=!complete[i] && (i==0?s.present:active && complete[i-1]);
+        uint32_t color=complete[i]?green:busy?amber:muted;
+        lv_label_set_text(_steps[i],complete[i]?"PASS":busy?"WAIT":"--");
+        lv_obj_set_style_text_color(_steps[i],lv_color_hex(color),0);
+        lv_obj_set_style_bg_color(_stepDots[i],lv_color_hex(complete[i]?green:busy?amber:0x344A58),0);
+    }
+    lv_label_set_text_fmt(_traffic,"TX %lu     RX %lu",(unsigned long)s.tx_packets,(unsigned long)s.rx_packets);
+    ax900_ipv4_info_t info={};
+    bool has_ip=s.has_ip && ax900_get_ipv4_info(&info);
+    if(has_ip) {
+        lv_label_set_text(_addresses[0],info.ip);
+        lv_label_set_text(_addresses[1],info.gateway);
+        lv_label_set_text(_addresses[2],info.netmask);
+        lv_label_set_text(_addresses[3],info.dns[0]?info.dns:"Not provided");
+    } else for(auto *field:_addresses)lv_label_set_text(field,"--");
+
+    ax900_metrics_t metrics;ax900_get_metrics(&metrics);
+    lv_obj_set_style_text_font(_traffic,&lv_font_montserrat_14,0);
+    lv_label_set_text_fmt(_traffic,"TX %lu  RX %lu  Drop %lu\nPool %llu / peak %llu  TX fail %llu",
+        (unsigned long)s.tx_packets,(unsigned long)s.rx_packets,(unsigned long)s.rx_dropped,
+        metrics.value[AX900_POOL_USED],metrics.value[AX900_POOL_PEAK],metrics.value[AX900_TX_USB_FAILED]);
+    if(lv_dropdown_get_selected(_mode)){
+        ax900_test_result_t t;ax900_test_get_result(&t);
+        if(t.state!=AX900_TEST_RUNNING && (_targetChanged || t.kind!=lv_dropdown_get_selected(_mode)-1))t={};
+        bool running=t.state==AX900_TEST_RUNNING;
+        if(has_ip)lv_obj_remove_state(_button,LV_STATE_DISABLED);else lv_obj_add_state(_button,LV_STATE_DISABLED);
+        lv_label_set_text(_buttonLabel,running?"Cancel":"Run test");
+        if(running){lv_obj_add_state(_mode,LV_STATE_DISABLED);lv_obj_add_state(_configure,LV_STATE_DISABLED);}
+        else{lv_obj_remove_state(_mode,LV_STATE_DISABLED);lv_obj_remove_state(_configure,LV_STATE_DISABLED);}
+        const char *states[]={"Choose a target and run","Testing...","Test passed","Test failed","Cancelled","Connection changed"};
+        auto help=!has_ip?ax900_connection_help(&s):ax900_test_help(&t,_startError);
+        lv_label_set_text(_headline,help.title[0]?help.title:states[t.state]);
+        const char *stages[]={"ready","interface","DNS","socket","connect","transfer","response"};
+        if(help.action[0])lv_label_set_text(_summary,help.action);
+        else if(t.state==AX900_TEST_PASSED || t.state==AX900_TEST_FAILED)
+            lv_label_set_text_fmt(_summary,"%s | %lu ms | %lu kbps | UDP %lu / %lu\nHTTP %d | errors %d / %d",
+                stages[t.stage],(unsigned long)t.elapsed_ms,(unsigned long)t.kilobits_per_second,(unsigned long)t.received,
+                (unsigned long)t.sent,t.http_status,t.error,t.socket_error);
+        else lv_label_set_text(_summary,_config.host[0]?_config.host:"Set a host, port and optional DNS server using Target.");
+        for(auto *sample:_samples)lv_label_set_text(sample,"--");
+        if(t.state>=AX900_TEST_PASSED){
+            lv_label_set_text_fmt(_samples[0],"%lu KB",(unsigned long)(t.bytes/1024));
+            lv_label_set_text_fmt(_samples[1],"%lu kbps",(unsigned long)t.kilobits_per_second);
+            lv_label_set_text_fmt(_samples[2],"%lu ms",(unsigned long)t.average_ms);
+            lv_label_set_text_fmt(_samples[3],"%lu KB",(unsigned long)(t.internal_after/1024));
+            if(t.kind==AX900_TEST_HTTP && t.http_status)lv_label_set_text_fmt(_samples[4],"HTTP %d",t.http_status);
+            else lv_label_set_text_fmt(_samples[4],"%lu KB min",(unsigned long)(t.internal_minimum/1024));
+        }
+        lv_bar_set_value(_progress,t.state==AX900_TEST_PASSED?AX900_PROBE_COUNT:0,LV_ANIM_OFF);return;
+    }
+    lv_obj_remove_state(_mode,LV_STATE_DISABLED);lv_obj_remove_state(_configure,LV_STATE_DISABLED);
+    ax900_probe_result_t p;ax900_probe_get_result(&p);
+    bool running=p.state==AX900_PROBE_RUNNING,stale=p.state==AX900_PROBE_STALE;
+    if(has_ip && !running)lv_obj_remove_state(_button,LV_STATE_DISABLED);
+    else lv_obj_add_state(_button,LV_STATE_DISABLED);
+    lv_label_set_text(_buttonLabel,running?"Testing...":"Run test");
+    bool measured=p.state!=AX900_PROBE_IDLE && !stale && !p.error;
+    uint32_t color=p.state==AX900_PROBE_PASSED?green:p.state==AX900_PROBE_PARTIAL?amber:ink;
+    if(!has_ip)lv_label_set_text(_headline,"Connect to Wi-Fi first");
+    else if(stale)lv_label_set_text(_headline,"Connection changed");
+    else if(running)lv_label_set_text_fmt(_headline,"Testing %lu / %u",(unsigned long)p.sent,AX900_PROBE_COUNT);
+    else if(p.error)lv_label_set_text(_headline,ax900_test_help(nullptr,p.error).title);
+    else if(p.received)lv_label_set_text_fmt(_headline,"%lu ms  average",(unsigned long)p.average_ms);
+    else lv_label_set_text(_headline,p.state==AX900_PROBE_FAILED?"No gateway reply":"Ready to test");
+    lv_obj_set_style_text_color(_headline,lv_color_hex(color),0);
+    if(has_ip && measured && p.sent && p.received)
+        lv_label_set_text_fmt(_summary,"%lu / %lu replies   |   %lu%% loss   |   min %lu / max %lu ms",
+            (unsigned long)p.received,(unsigned long)p.sent,(unsigned long)((p.sent-p.received)*100/p.sent),(unsigned long)p.min_ms,(unsigned long)p.max_ms);
+    else if(stale)lv_label_set_text(_summary,"Run a new test for the current connection.");
+    else if(p.error && has_ip)lv_label_set_text(_summary,ax900_test_help(nullptr,p.error).action);
+    else if(p.state==AX900_PROBE_FAILED && has_ip)lv_label_set_text(_summary,"Gateway may block ping. Try TCP/HTTP to check connectivity.");
+    else lv_label_set_text(_summary,"5 requests  /  latency and packet loss");
+    if(!has_ip){auto help=ax900_connection_help(&s);lv_label_set_text(_headline,help.title[0]?help.title:"Connect to Wi-Fi first");lv_label_set_text(_summary,help.action[0]?help.action:"Select a network and wait for an IP address.");}
+    lv_bar_set_value(_progress,measured && has_ip?p.sent:0,LV_ANIM_OFF);
+    for(unsigned i=0;i<AX900_PROBE_COUNT;i++) {
+        int32_t rtt=measured && has_ip?p.rtt_ms[i]:-1;
+        if(rtt>=0)lv_label_set_text_fmt(_samples[i],"%ld ms",(long)rtt);
+        else lv_label_set_text(_samples[i],rtt==-2?"Timeout":"--");
+        lv_obj_set_style_text_color(_samples[i],lv_color_hex(rtt>=0?green:rtt==-2?amber:muted),0);
+        lv_obj_center(_samples[i]);
+    }
+}
+#endif
diff --git a/platforms/tab5/main/ax900_console.cpp b/platforms/tab5/main/ax900_console.cpp
new file mode 100644
--- /dev/null
+++ b/platforms/tab5/main/ax900_console.cpp
@@ -0,0 +1,134 @@
+// SPDX-License-Identifier: MIT
+// Local USB diagnostic commands for repeatable hardware and display verification.
+#include <ax900.h>
+#include <ax900_probe.h>
+#include <ax900_test.h>
+#include <ax900_diagnostics.h>
+#include <ax900_metrics.h>
+#include <esp_heap_caps.h>
+#include <hal/hal.h>
+#include <lvgl.h>
+#include <unistd.h>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <esp_netif.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <hal/components/tab5_keyboard.h>
+extern void ax900_ui_request_open();
+extern void ax900_ui_request_select(const char *ssid);
+extern bool ax900_ui_can_snapshot();
+
+extern void ax900_ui_request_test(bool run);
+static void probe_status() {
+    ax900_probe_result_t p;ax900_probe_get_result(&p);
+    printf("AX900_PROBE state=%u sent=%lu received=%lu avg_ms=%lu min_ms=%lu max_ms=%lu elapsed_ms=%lu error=%d\n",
+        p.state,(unsigned long)p.sent,(unsigned long)p.received,(unsigned long)p.average_ms,
+        (unsigned long)p.min_ms,(unsigned long)p.max_ms,(unsigned long)p.elapsed_ms,p.error);
+}
+
+static void snapshot() {
+    lv_draw_buf_t *buffer;
+    {LvglLockGuard lock;if(!ax900_ui_can_snapshot()){printf("AXSNAP BLOCKED credential dialog\n");return;}buffer=lv_snapshot_take(lv_screen_active(),LV_COLOR_FORMAT_RGB565);}
+    if(!buffer){printf("AXSNAP ERROR allocation\n");return;}
+    const unsigned width=buffer->header.w,height=buffer->header.h;
+    std::unique_ptr<char[]> line(new(std::nothrow) char[width*6+1]);
+    if(!line){lv_draw_buf_destroy(buffer);return;}
+    printf("AXSNAP BEGIN %u %u RGB565-RLE\n",width,height);
+    constexpr char hex[]="0123456789abcdef";
+    for(unsigned y=0;y<height;y++) {
+        const auto *row=reinterpret_cast<const uint16_t *>(buffer->data+y*buffer->header.stride);
+        size_t pos=0;
+        for(unsigned x=0;x<width;) {
+            uint16_t color=row[x];unsigned count=1;
+            while(count<255 && x+count<width && row[x+count]==color)count++;
+            uint8_t bytes[]={static_cast<uint8_t>(count),static_cast<uint8_t>(color),static_cast<uint8_t>(color>>8)};
+            for(auto b:bytes){line[pos++]=hex[b>>4];line[pos++]=hex[b&15];}
+            x+=count;
+        }
+        line[pos]=0;printf("AXSNAP ROW %u %s\n",y,line.get());
+        if(y%8==0)vTaskDelay(1);
+    }
+    printf("AXSNAP END\n");lv_draw_buf_destroy(buffer);
+}
+void ax900_console_poll() {
+    static char command[384];static size_t used=0;
+    // The default USB Serial/JTAG VFS uses non-blocking hardware reads already.
+    // O_NONBLOCK would skip its one-byte prefetch when no ring-buffer driver exists.
+    char input[64];ssize_t n=read(STDIN_FILENO,input,sizeof(input));
+    for(ssize_t i=0;i<n;i++) {
+        if(input[i]=='\n' || input[i]=='\r') {
+            command[used]=0;used=0;
+            if(!strcmp(command,"ax900 scan"))printf("AX900_SCAN_REQUEST %d\n",ax900_request_scan());
+            else if(!strcmp(command,"ax900 start"))printf("AX900_START %d\n",ax900_start());
+            else if(!strcmp(command,"ax900 stop"))printf("AX900_STOP %d\n",ax900_stop());
+            else if(!strncmp(command,"ax900 saved ",12)) {
+                auto s=std::make_unique<ax900_status_t>();ax900_get_status(s.get());
+                const ax900_ap_t *best=nullptr;
+                for(size_t j=0;j<s->ap_count;j++)if(!strcmp(s->aps[j].ssid,command+12) && ax900_has_saved(&s->aps[j]) &&
+                    (!best || (s->aps[j].frequency>5000 && best->frequency<=5000) ||
+                     ((s->aps[j].frequency>5000)==(best->frequency>5000) && s->aps[j].rssi>best->rssi)))best=&s->aps[j];
+                printf("AX900_SAVED_CONNECT %d\n",best?ax900_connect_saved(best):ESP_ERR_NOT_FOUND);
+            }
+            else if(!strcmp(command,"ax900 open"))ax900_ui_request_open();
+            else if(!strncmp(command,"ax900 select ",13))ax900_ui_request_select(command+13);
+            else if(!strncmp(command,"ax900 associate ",16)) {
+                auto s=std::make_unique<ax900_status_t>();ax900_get_status(s.get());
+                const ax900_ap_t *best=nullptr;unsigned frequency=0;int offset=0;
+                const char *ssid=command+16;
+                if(sscanf(ssid,"%u %n",&frequency,&offset)==1 && offset>0)ssid+=offset;
+                else frequency=0;
+                for(size_t j=0;j<s->ap_count;j++)if(!strcmp(s->aps[j].ssid,ssid) && s->aps[j].frequency>5000 && (!frequency || s->aps[j].frequency==frequency) && (!best || s->aps[j].rssi>best->rssi))best=&s->aps[j];
+                printf("AX900_ASSOCIATE_TEST %d\n",best?ax900_test_association(best):ESP_ERR_NOT_FOUND);
+            }
+            else if(!strncmp(command,"ax900 check ",12)) {
+                ax900_test_config_t c={};unsigned kind=0,port=0;char extra=0;
+                int fields=sscanf(command+12,"%u %253s %u %15s %c",&kind,c.host,&port,c.dns_ipv4,&extra);
+                c.kind=static_cast<ax900_test_kind_t>(kind);c.port=port;c.timeout_ms=30000;c.bytes=1048576;
+                snprintf(c.path,sizeof(c.path),"/health");
+                printf("AX900_CHECK_START %d\n",(fields==3 || fields==4) && port>0 && port<=65535?ax900_test_start(&c):ESP_ERR_INVALID_ARG);
+            }
+            else if(!strcmp(command,"ax900 check-cancel"))ax900_test_cancel();
+            else if(!strcmp(command,"ax900 check-status")) {
+                ax900_test_result_t t;ax900_test_get_result(&t);
+                printf("AX900_CHECK state=%u kind=%u stage=%u error=%d socket_error=%d http=%d elapsed_ms=%lu bytes=%lu kbps=%lu sent=%lu received=%lu avg_ms=%lu internal_before=%lu internal_after=%lu internal_min=%lu\n",
+                    t.state,t.kind,t.stage,t.error,t.socket_error,t.http_status,(unsigned long)t.elapsed_ms,(unsigned long)t.bytes,
+                    (unsigned long)t.kilobits_per_second,(unsigned long)t.sent,(unsigned long)t.received,(unsigned long)t.average_ms,
+                    (unsigned long)t.internal_before,(unsigned long)t.internal_after,(unsigned long)t.internal_minimum);
+            }
+            else if(!strcmp(command,"ax900 probe"))printf("AX900_PROBE_START %d\n",ax900_probe_start());
+            else if(!strcmp(command,"ax900 test"))ax900_ui_request_test(false);
+            else if(!strcmp(command,"ax900 test-run"))ax900_ui_request_test(true);
+            else if(!strcmp(command,"ax900 test-status"))probe_status();
+            else if(!strcmp(command,"ax900 keyboard")){LvglLockGuard lock;printf("TAB5_KEYBOARD connected=%u\n",tab5_keyboard_connected());}
+            else if(!strcmp(command,"ax900 disconnect"))printf("AX900_DISCONNECT %d\n",ax900_disconnect());
+#if CONFIG_AX900_FAULT_INJECTION
+            else if(!strcmp(command,"ax900 fault-rx"))printf("AX900_FAULT %d\n",ax900_debug_fault(AX900_FAULT_RX));
+            else if(!strcmp(command,"ax900 fault-link"))printf("AX900_FAULT %d\n",ax900_debug_fault(AX900_FAULT_LINK));
+            else if(!strcmp(command,"ax900 fault-dhcp"))printf("AX900_FAULT %d\n",ax900_debug_fault(AX900_FAULT_DHCP));
+#endif
+            else if(!strcmp(command,"ax900 snapshot"))snapshot();
+            else if(!strcmp(command,"ax900 status")) {
+                auto s=std::make_unique<ax900_status_t>();ax900_get_status(s.get());
+                unsigned band5=0;for(size_t j=0;j<s->ap_count;j++)band5+=s->aps[j].frequency>5000;
+                printf("AX900_STATUS ready=%d supports5=%d scanning=%d generation=%lu APs=%u band5=%u status=%s\n",
+                    s->ready,s->supports_5ghz,s->scanning,static_cast<unsigned long>(s->scan_generation),static_cast<unsigned>(s->ap_count),band5,s->status);
+                printf("AX900_LINK connecting=%d associated=%d authenticated=%d has_ip=%d ip=%s tx=%lu rx=%lu dropped=%lu reason=%u\n",
+                    s->connecting,s->associated,s->authenticated,s->has_ip,s->ip,
+                    static_cast<unsigned long>(s->tx_packets),static_cast<unsigned long>(s->rx_packets),
+                    static_cast<unsigned long>(s->rx_dropped),s->disconnect_reason);
+                printf("AX900_SAVED count=%u current=%u error=%d\n",s->saved_networks,s->credentials_saved,s->profile_error);
+                printf("AX900_RUNTIME lifecycle=%u frequency=%u connection_id=%lu\n",ax900_get_lifecycle(),s->connected_frequency,(unsigned long)s->connection_id);
+                ax900_metrics_t m;ax900_get_metrics(&m);
+                printf("AX900_METRICS pool=%llu pool_peak=%llu tx_full=%llu tx_empty=%llu tx_failed=%llu rx_full=%llu rx_empty=%llu inflight=%llu\n",
+                    m.value[AX900_POOL_USED],m.value[AX900_POOL_PEAK],m.value[AX900_TX_QUEUE_FULL],m.value[AX900_TX_POOL_EMPTY],
+                    m.value[AX900_TX_USB_FAILED],m.value[AX900_RX_QUEUE_FULL],m.value[AX900_RX_POOL_EMPTY],m.value[AX900_USB_INFLIGHT]);
+                printf("AX900_RECOVERY enabled=%u pending=%u attempts=%u in_ms=%lu usb_errors=%lu usb_recoveries=%lu error=%d heap=%u internal=%u\n",
+                    s->reconnect_enabled,s->reconnect_pending,s->reconnect_attempts,(unsigned long)s->reconnect_in_ms,
+                    (unsigned long)s->usb_errors,(unsigned long)s->usb_recoveries,s->transport_error,
+                    (unsigned)heap_caps_get_free_size(MALLOC_CAP_8BIT),(unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL|MALLOC_CAP_8BIT));
+            }
+        } else if(used<sizeof(command)-1)command[used++]=input[i];
+    }
+}
