+// SPDX-FileCopyrightText: 2026 M5Stack Technology CO LTD
+// SPDX-License-Identifier: MIT
+// Matrix protocol and layout based on m5stack/M5Unit-KEYBOARD UnitTab5Keyboard.
+#pragma once
+#include <cstdint>
+#include <cstring>
+
+namespace tab5_keyboard {
+// LVGL keypad codes, kept independent of LVGL for host verification.
+enum : uint32_t { Up=17, Down=18, Right=19, Left=20, Escape=27, Delete=127, Backspace=8, Enter=10, Next=9, Prev=11 };
+class Decoder {
+public:
+    void reset(){std::memset(down,0,sizeof(down));active=-1;key=0;pressed=false;}
+    bool feed(uint8_t raw) {
+        if(raw==0xff)return false;
+        unsigned row=(raw>>4)&7,col=raw&15;
+        if(row>=5 || col>=14)return false;
+        unsigned i=row*14+col;bool press=raw&0x80;
+        if(down[i]==press)return false;
+        down[i]=press;
+        if(!press){if(active==(int)i){pressed=false;active=-1;return true;}return false;}
+        if(i==42 || i==43 || i==56 || i==57 || down[56] || down[57])return false;
+        uint32_t value=base[i];
+        if(down[42]) {
+            static constexpr uint32_t symrow[]={ '~','?','@','#','$','%','^','&','/','<','>','{','}','|' };
+            if(row==1)value=symrow[col];
+            if(i==39)value=':';
+            if(i==40)value='"';
+            if(i==54)value='=';
+            if(i==65)value=',';
+        }
+        if(down[43]) {
+            if(value>='a' && value<='z')value-=32;
+            else {
+                const char *normal="1234567890-=[]\\;\'`,./";
+                const char *shifted="!@#$%^&*()_+{}|:\"~<>?";
+                const char *p=value>=32 && value<127?std::strchr(normal,(int)value):nullptr;
+                if(p)value=shifted[p-normal];
+            }
+            if(value==Next)value=Prev;
+        }
+        if(!value)return false;
+        key=value;pressed=true;active=i;return true;
+    }
+    uint32_t key=0;
+    bool pressed=false;
+private:
+    bool down[70]={};int active=-1;
+    static constexpr uint32_t base[70]={
+        Escape,'1','2','3','4','5','6','7','8','9','0','-','+',Delete,
+        '`','!','@','#','$','%','^','&','*','(',')','[',']','\\',
+        Next,'q','w','e','r','t','y','u','i','o','p',';','\'',Backspace,
+        0,0,'a','s','d','f','g','h','j','k','l',Up,'_',Enter,
+        0,0,'z','x','c','v','b','n','m','.',Left,Down,Right,' '
+    };
+};
+}
diff --git a/platforms/tab5/main/hal/components/tab5_keyboard.cpp b/platforms/tab5/main/hal/components/tab5_keyboard.cpp
new file mode 100644
--- /dev/null
+++ b/platforms/tab5/main/hal/components/tab5_keyboard.cpp
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: MIT
+#include "tab5_keyboard.h"
+#include "tab5_keyboard_map.h"
+#include <bsp/m5stack_tab5.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+
+namespace {
+i2c_master_dev_handle_t device=nullptr;
+i2c_master_bus_handle_t bus=nullptr;
+lv_indev_t *input=nullptr;
+bool connected=false;
+int64_t nextProbe=0;
+tab5_keyboard::Decoder decoder;
+uint32_t deliveredKey=0;
+bool deliveredPressed=false,pendingPress=false;
+bool read(uint8_t reg,uint8_t &value) {
+    return i2c_master_transmit_receive(device,&reg,1,&value,1,10)==ESP_OK;
+}
+bool write(uint8_t reg,uint8_t value) {
+    uint8_t bytes[]={reg,value};return i2c_master_transmit(device,bytes,2,10)==ESP_OK;
+}
+void lost() {
+    if(connected)ESP_LOGI("Tab5Keyboard","Disconnected");
+    connected=false;decoder.reset();pendingPress=false;nextProbe=esp_timer_get_time()+1000000;
+}
+void readKeys(lv_indev_t *,lv_indev_data_t *data) {
+    data->state=LV_INDEV_STATE_RELEASED;data->key=decoder.key;
+    if(!device)return;
+    if(pendingPress){pendingPress=false;deliveredKey=decoder.key;deliveredPressed=true;
+        data->key=deliveredKey;data->state=LV_INDEV_STATE_PRESSED;data->continue_reading=true;return;}
+    if(!connected) {
+        if(esp_timer_get_time()<nextProbe)return;
+        nextProbe=esp_timer_get_time()+1000000;
+        if(!bus || i2c_master_probe(bus,0x6d,10)!=ESP_OK)return;
+        uint8_t address=0,version=0;
+        if(!read(0xff,address) || address!=0x6d || !read(0xfe,version) || !write(0x10,0) || !write(0x00,0) || !write(0x02,0))return;
+        decoder.reset();connected=true;
+        ESP_LOGI("Tab5Keyboard","Connected: I2C 0x6D, firmware=%u",version);
+    }
+    // Bounded draining prevents an active keyboard from starving display refresh.
+    for(unsigned budget=0;budget<8;budget++) {
+        uint8_t raw=0xff;
+        if(!read(0x20,raw)){lost();break;}
+        if(raw==0xff)break;
+        if(decoder.feed(raw)) {
+            data->continue_reading=true;
+            // LVGL requires a release edge between different key-down events,
+            // including overlapping keys during fast typing.
+            if(decoder.pressed && deliveredPressed){pendingPress=true;deliveredPressed=false;
+                data->key=deliveredKey;data->state=LV_INDEV_STATE_RELEASED;return;}
+            break;
+        }
+    }
+    data->key=decoder.key;data->state=decoder.pressed?LV_INDEV_STATE_PRESSED:LV_INDEV_STATE_RELEASED;
+    deliveredKey=decoder.key;deliveredPressed=decoder.pressed;
+}
+}
+lv_indev_t *tab5_keyboard_init(lv_display_t *display) {
+    if(input)return input;
+    // P4's separate LP controller can use GPIO 0/1 while Port A keeps HP I2C1
+    // on GPIO 53/54 and the board's internal devices keep HP I2C0.
+    i2c_master_bus_config_t busConfig={};
+    busConfig.i2c_port=LP_I2C_NUM_0;busConfig.sda_io_num=GPIO_NUM_0;busConfig.scl_io_num=GPIO_NUM_1;
+    busConfig.lp_source_clk=LP_I2C_SCLK_DEFAULT;busConfig.flags.enable_internal_pullup=true;
+    esp_err_t error=i2c_new_master_bus(&busConfig,&bus);
+    if(error!=ESP_OK){ESP_LOGE("Tab5Keyboard","Bus init failed: %s",esp_err_to_name(error));return nullptr;}
+    i2c_device_config_t cfg={};cfg.dev_addr_length=I2C_ADDR_BIT_LEN_7;cfg.device_address=0x6d;cfg.scl_speed_hz=100000;
+    if(i2c_master_bus_add_device(bus,&cfg,&device)!=ESP_OK){i2c_del_master_bus(bus);bus=nullptr;return nullptr;}
+    input=lv_indev_create();lv_indev_set_type(input,LV_INDEV_TYPE_KEYPAD);
+    lv_indev_set_display(input,display);lv_indev_set_read_cb(input,readKeys);
+    lv_indev_set_long_press_time(input,400);
+    return input;
+}
+void tab5_keyboard_set_group(lv_group_t *group) {
+    decoder.reset();deliveredKey=0;deliveredPressed=false;pendingPress=false;
+    if(connected && !write(0x02,0))lost();
+    if(input){lv_indev_reset(input,nullptr);lv_indev_set_group(input,group);}
+}
+bool tab5_keyboard_connected(){return connected;}
