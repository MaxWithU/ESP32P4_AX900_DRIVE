+        _list->setBgColor(lv_color_hex(0x111C22));_list->setBorderWidth(0);
+        _list->setPadding(14,14,14,14);
+        lv_obj_set_flex_flow(_list->get(),LV_FLEX_FLOW_COLUMN);
+        lv_obj_set_scroll_dir(_list->get(),LV_DIR_VER);
+        for(unsigned i=0;i<2;i++) {
+            _tabs[i]=lv_button_create(_window->get());lv_obj_set_pos(_tabs[i],24+i*210,50);lv_obj_set_size(_tabs[i],200,44);
+            lv_obj_set_style_radius(_tabs[i],12,0);auto *text=lv_label_create(_tabs[i]);
+            lv_label_set_text(text,i?"Connection test":"Networks");lv_obj_center(text);
+            lv_obj_add_event_cb(_tabs[i],[](lv_event_t *e){
+                auto *self=static_cast<Ax900Window *>(lv_event_get_user_data(e));
+                self->showTest(lv_event_get_current_target(e)==self->_tabs[1]);
+            },LV_EVENT_CLICKED,this);
+        }
+        _testView=std::make_unique<Ax900TestView>(_window->get());showTest(false);
+        _memory=lv_label_create(_window->get());lv_obj_set_pos(_memory,680,111);
+        lv_obj_set_style_text_font(_memory,&lv_font_montserrat_14,0);
+        _forget=lv_button_create(_window->get());lv_obj_set_pos(_forget,766,50);lv_obj_set_size(_forget,154,46);
+        auto *forgetText=lv_label_create(_forget);lv_label_set_text(forgetText,"Forget saved");lv_obj_center(forgetText);
+        lv_obj_add_event_cb(_forget,[](lv_event_t *){ax900_forget_saved();},LV_EVENT_CLICKED,nullptr);
+        for(auto *tab:_tabs)lv_group_add_obj(_group,tab);
