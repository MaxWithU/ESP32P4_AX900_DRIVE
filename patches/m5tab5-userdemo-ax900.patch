+    lv_obj_t *_tabs[2]={};
+    lv_obj_t *_memory=nullptr,*_forget=nullptr;
+    lv_group_t *_group=nullptr,*_dialogGroup=nullptr;
+    bool _showTest=false;
+    void showTest(bool show) {
+        _showTest=show;
+        if(show)lv_obj_add_flag(_list->get(),LV_OBJ_FLAG_HIDDEN);else lv_obj_remove_flag(_list->get(),LV_OBJ_FLAG_HIDDEN);
+        _testView->show(show);
+        for(unsigned i=0;i<2;i++)lv_obj_set_style_bg_color(_tabs[i],lv_color_hex((i==1)==show?0x247F9C:0x243743),0);
+    }
+    lv_obj_t *_dialog=nullptr,*_password=nullptr,*_dialogStatus=nullptr,*_username=nullptr,*_unverified=nullptr;
+    ax900_ap_t _selected={};
+    void closeDialog() {
+        if(_dialogGroup){tab5_keyboard_set_group(_group);lv_group_delete(_dialogGroup);_dialogGroup=nullptr;}
+        if(_dialog){if(_password)lv_textarea_set_text(_password,"");if(_username)lv_textarea_set_text(_username,"");lv_obj_delete(_dialog);}
+        credentialDialogOpen=false;
+        _dialog=nullptr;_password=nullptr;_dialogStatus=nullptr;_username=nullptr;_unverified=nullptr;
+    }
+    void select(size_t index) {
+        if(!_snapshot || _snapshot->scanning || index>=_snapshot->ap_count || _dialog)return;
+        _selected=_snapshot->aps[index];
+        credentialDialogOpen=true;
+        _dialogGroup=lv_group_create();tab5_keyboard_set_group(_dialogGroup);
+        _dialog=lv_obj_create(lv_screen_active());lv_obj_set_size(_dialog,1080,640);lv_obj_center(_dialog);
+        lv_obj_set_style_bg_color(_dialog,lv_color_hex(0x18242B),0);
+        auto *title=lv_label_create(_dialog);lv_obj_align(title,LV_ALIGN_TOP_LEFT,15,8);
+        lv_label_set_text_fmt(title,"Connect to %s  (%s)",_selected.ssid,_selected.frequency>5000?"5 GHz":"2.4 GHz");
+        _dialogStatus=lv_label_create(_dialog);lv_obj_align(_dialogStatus,LV_ALIGN_TOP_LEFT,15,45);
+        lv_label_set_text(_dialogStatus,_selected.secured?"WPA2 Personal - enter password":"Open network");
+        bool supported=_selected.ssid_len && (!_selected.secured || ((_selected.wpa2_psk || _selected.enterprise) && !_selected.pmf_required));
+        if(!supported)lv_label_set_text(_dialogStatus,_selected.enterprise?"This network requires enterprise authentication.":"This network's authentication is not supported yet.");
+        if(_selected.enterprise) {
+            lv_label_set_text(_dialogStatus,"WPA2 Enterprise - PEAP / MSCHAPv2");
+            _username=lv_textarea_create(_dialog);lv_obj_set_size(_username,495,58);
+            lv_obj_align(_username,LV_ALIGN_TOP_LEFT,15,82);lv_textarea_set_one_line(_username,true);
+            lv_textarea_set_max_length(_username,128);lv_textarea_set_placeholder_text(_username,"Username (or DOMAIN\\user)");
+            _unverified=lv_checkbox_create(_dialog);lv_obj_align(_unverified,LV_ALIGN_TOP_LEFT,15,158);
+            lv_checkbox_set_text(_unverified,"Server certificate not verified (untrusted server risk)");
+            lv_obj_add_state(_unverified,LV_STATE_CHECKED);
+        }
+        _password=lv_textarea_create(_dialog);lv_obj_set_size(_password,1015,58);lv_obj_align(_password,LV_ALIGN_TOP_LEFT,15,82);
+        lv_textarea_set_one_line(_password,true);lv_textarea_set_password_mode(_password,true);lv_textarea_set_password_show_time(_password,0);
+        if(_selected.enterprise){lv_obj_set_size(_password,495,58);lv_obj_align(_password,LV_ALIGN_TOP_LEFT,535,82);}
+        lv_textarea_set_max_length(_password,_selected.enterprise?128:64);lv_textarea_set_placeholder_text(_password,_selected.enterprise?"Account password":"Wi-Fi password");
+        if(!_selected.secured)lv_obj_add_state(_password,LV_STATE_DISABLED);
+        auto *connect=lv_button_create(_dialog);lv_obj_set_size(connect,160,48);lv_obj_align(connect,LV_ALIGN_TOP_RIGHT,-15,220);
+        auto *label=lv_label_create(connect);lv_label_set_text(label,"Connect");lv_obj_center(label);
+        lv_obj_add_event_cb(connect,[](lv_event_t *e){
+            auto *self=static_cast<Ax900Window *>(lv_event_get_user_data(e));
+            const char *password=self->_selected.secured?lv_textarea_get_text(self->_password):"";
+            esp_err_t result;
+            if(self->_selected.enterprise) {
+                ax900_peap_config_t config={};config.username=lv_textarea_get_text(self->_username);config.password=password;
+                config.allow_unverified_server=lv_obj_has_state(self->_unverified,LV_STATE_CHECKED);
+                result=ax900_connect_peap(&self->_selected,&config);
+            } else result=ax900_connect(&self->_selected,password);
+            if(result==ESP_OK)self->closeDialog();
+            else lv_label_set_text(self->_dialogStatus,result==ESP_ERR_INVALID_STATE?"Wait for scanning to finish, or disconnect first.":"Check account/password and certificate option.");
+        },LV_EVENT_CLICKED,this);
+        if(!supported)lv_obj_add_state(connect,LV_STATE_DISABLED);
+        auto *cancel=lv_button_create(_dialog);lv_obj_set_size(cancel,140,48);lv_obj_align(cancel,LV_ALIGN_TOP_RIGHT,-195,220);
+        label=lv_label_create(cancel);lv_label_set_text(label,"Cancel");lv_obj_center(label);
+        lv_obj_add_event_cb(cancel,[](lv_event_t *e){static_cast<Ax900Window *>(lv_event_get_user_data(e))->closeDialog();},LV_EVENT_CLICKED,this);
+        auto *keyboard=lv_keyboard_create(_dialog);lv_obj_set_size(keyboard,1040,310);lv_obj_align(keyboard,LV_ALIGN_BOTTOM_MID,0,-5);
+        auto focus=[](lv_event_t *e){lv_keyboard_set_textarea(static_cast<lv_obj_t *>(lv_event_get_user_data(e)),static_cast<lv_obj_t *>(lv_event_get_target(e)));};
+        lv_obj_add_event_cb(_password,focus,LV_EVENT_FOCUSED,keyboard);
+        if(_username)lv_obj_add_event_cb(_username,focus,LV_EVENT_FOCUSED,keyboard);
+        lv_keyboard_set_textarea(keyboard,_username?_username:_password);
+        if(ax900_has_saved(&_selected)) {
+            auto *saved=lv_button_create(_dialog);lv_obj_set_size(saved,180,48);lv_obj_align(saved,LV_ALIGN_TOP_LEFT,15,220);
+            label=lv_label_create(saved);lv_label_set_text(label,"Use saved login");lv_obj_center(label);
+            lv_obj_add_event_cb(saved,[](lv_event_t *e){auto *self=static_cast<Ax900Window *>(lv_event_get_user_data(e));
+                if(ax900_connect_saved(&self->_selected)==ESP_OK)self->closeDialog();
+                else lv_label_set_text(self->_dialogStatus,"Disconnect first, or enter a new password.");
+            },LV_EVENT_CLICKED,this);
+            lv_group_add_obj(_dialogGroup,saved);
+        }
+        if(_username)lv_group_add_obj(_dialogGroup,_username);
+        if(_selected.secured)lv_group_add_obj(_dialogGroup,_password);
+        if(_unverified)lv_group_add_obj(_dialogGroup,_unverified);
+        lv_group_add_obj(_dialogGroup,connect);lv_group_add_obj(_dialogGroup,cancel);
+        auto advance=[](lv_event_t *e){
+            lv_group_focus_obj(static_cast<lv_obj_t *>(lv_event_get_user_data(e)));
+            if(auto *input=lv_indev_active())lv_indev_wait_release(input);
+        };
+        if(_username)lv_obj_add_event_cb(_username,advance,LV_EVENT_READY,_password);
+        lv_obj_add_event_cb(_password,advance,LV_EVENT_READY,connect);
+        for(unsigned i=0;i<lv_group_get_obj_count(_dialogGroup);i++)lv_obj_add_event_cb(lv_group_get_obj_by_index(_dialogGroup,i),[](lv_event_t *e){
+            if(lv_event_get_key(e)==LV_KEY_ESC)static_cast<Ax900Window *>(lv_event_get_user_data(e))->closeDialog();
+        },LV_EVENT_KEY,this);
+        lv_group_focus_obj(_username?_username:_selected.secured?_password:connect);
+    }
+    uint32_t _time=0,_generation=UINT32_MAX;size_t _count=SIZE_MAX;
+    void refresh() {
+        if(!_snapshot)return;
+        _time=GetHAL()->millis();ax900_get_status(_snapshot.get());
+        auto &s=*_snapshot;
+        openRequested=false;
+        if(testRequested && !_dialog){showTest(true);testRequested=false;}
+        _testView->update(s);
+        if(runRequested && !_dialog){_testView->run();runRequested=false;}
+        _status->setText(s.status);
+        lv_label_set_text_fmt(_memory,"Keyboard: %s   |   %s (%u)",tab5_keyboard_connected()?"ready":"not attached",
+            s.profile_error?"Save failed":s.credentials_saved?"Wi-Fi saved":"Saved networks",s.saved_networks);
+        if(s.saved_networks)lv_obj_remove_state(_forget,LV_STATE_DISABLED);else lv_obj_add_state(_forget,LV_STATE_DISABLED);
+        _scanLabel->setText((s.associated || s.connecting)?"Disconnect":"Scan again");
+        if(s.ready && !s.scanning)lv_obj_remove_state(_scan->get(),LV_STATE_DISABLED);
+        else lv_obj_add_state(_scan->get(),LV_STATE_DISABLED);
+        std::sort(s.aps,s.aps+s.ap_count,[](const ax900_ap_t&a,const ax900_ap_t&b) {
+            if((a.frequency>5000)!=(b.frequency>5000))return a.frequency>5000;
+            return a.rssi>b.rssi;
+        });
+        if(selectRequested[0] && !s.scanning && !_dialog) {
+            for(size_t i=0;i<s.ap_count;i++)if(s.aps[i].frequency>5000 && !strcmp(s.aps[i].ssid,selectRequested)){select(i);selectRequested[0]=0;break;}
+        }
+        if(_generation==s.scan_generation && _count==s.ap_count)return;
+        _generation=s.scan_generation;_count=s.ap_count;
+        lv_obj_clean(_list->get());
+
+        for(size_t i=0;i<s.ap_count;i++) {
+            auto &ap=s.aps[i];unsigned ch=ap.frequency>5000?(ap.frequency-5000)/5:(ap.frequency-2407)/5;
+            auto *row=lv_obj_create(_list->get());lv_obj_set_size(row,LV_PCT(100),58);
+            lv_obj_remove_flag(row,LV_OBJ_FLAG_SCROLLABLE);
+            lv_group_add_obj(_group,row);
+            lv_obj_add_flag(row,LV_OBJ_FLAG_CLICKABLE);lv_obj_set_user_data(row,reinterpret_cast<void *>(i+1));
+            lv_obj_add_event_cb(row,[](lv_event_t *e){
+                auto *self=static_cast<Ax900Window *>(lv_event_get_user_data(e));
+                auto *row=static_cast<lv_obj_t *>(lv_event_get_current_target(e));
+                self->select(reinterpret_cast<size_t>(lv_obj_get_user_data(row))-1);
+            },LV_EVENT_CLICKED,this);
+            lv_obj_set_style_bg_color(row,lv_color_hex(ap.frequency>5000?0x183D42:0x20303A),0);
+            lv_obj_set_style_border_width(row,0,0);
+            auto *name=lv_label_create(row);lv_obj_align(name,LV_ALIGN_LEFT_MID,0,0);
+            lv_obj_set_width(name,560);lv_label_set_long_mode(name,LV_LABEL_LONG_DOT);
+            lv_obj_set_style_text_font(name,&lv_font_montserrat_20,0);
+            lv_label_set_text(name,ap.ssid[0]?ap.ssid:"(hidden network)");
+            auto *detail=lv_label_create(row);lv_obj_align(detail,LV_ALIGN_RIGHT_MID,0,0);
+            lv_label_set_text_fmt(detail,"%s   CH %u   %d dBm",ap.frequency>5000?"5 GHz":"2.4 GHz",ch,ap.rssi);
+        }
+        if(!s.ap_count) {
+            auto *empty=lv_label_create(_list->get());
+            lv_label_set_text(empty,s.scanning?"Searching for nearby networks...":"No networks yet. Connect AX900 and scan again.");
+        }
+    }
+};
+
+void PanelAx900::init() {
+    _button=std::make_unique<Container>(lv_screen_active());
+    _button->setSize(180,44);_button->align(LV_ALIGN_TOP_RIGHT,-20,12);
+    _button->setBgColor(lv_color_hex(0x205868));_button->setBorderWidth(0);
+    _button->removeFlag(LV_OBJ_FLAG_SCROLLABLE);
+    _label=std::make_unique<Label>(_button->get());_label->align(LV_ALIGN_CENTER,0,0);
+    _label->setText("AX900 Wi-Fi");_label->setTextFont(&lv_font_montserrat_18);
+    _button->onClick().connect([this] {
+        if(!_window) {_window=std::make_unique<Ax900Window>();_window->init(lv_screen_active());_window->open();}
+    });
+}
+void PanelAx900::update(bool isStacked) {
+    if(openRequested && !isStacked && !_window) {
+        openRequested=false;
+        _window=std::make_unique<Ax900Window>();_window->init(lv_screen_active());_window->open();
+    }
+    if(_window) {_window->update();if(_window->getState()==ui::Window::Closed)_window.reset();}
+    if(isStacked)_button->removeFlag(LV_OBJ_FLAG_CLICKABLE);
+    else _button->addFlag(LV_OBJ_FLAG_CLICKABLE);
+}
+#endif
