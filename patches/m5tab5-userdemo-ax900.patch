+    for(unsigned i=0;i<4;i++) {
+        _stepDots[i]=box(connection,24,149+i*51,12,12,0x344A58);
+        lv_obj_set_style_radius(_stepDots[i],6,0);
+        label(connection,stages[i],50,144+i*51,&lv_font_montserrat_16,ink);
