+void Ax900TestView::update(const ax900_status_t &s) {
+    bool active=s.connecting || s.associated;
+    lv_label_set_text(_ssid,active && s.connected_ssid[0]?s.connected_ssid:"No network");
+    if(active && s.connected_frequency) {
+        unsigned channel=s.connected_frequency>5000?(s.connected_frequency-5000)/5:(s.connected_frequency-2407)/5;
+        lv_label_set_text_fmt(_band,"%s   /   CH %u   /   %u MHz",s.connected_frequency>5000?"5 GHz":"2.4 GHz",channel,s.connected_frequency);
+    } else lv_label_set_text(_band,"Select a network to connect");
+    bool complete[]={s.ready,s.associated,s.authenticated,s.has_ip};
+    for(unsigned i=0;i<4;i++) {
+        bool busy=!complete[i] && (i==0?s.present:active && complete[i-1]);
+        uint32_t color=complete[i]?green:busy?amber:muted;
+        lv_label_set_text(_steps[i],complete[i]?"PASS":busy?"WAIT":"--");
+        lv_obj_set_style_text_color(_steps[i],lv_color_hex(color),0);
+        lv_obj_set_style_bg_color(_stepDots[i],lv_color_hex(complete[i]?green:busy?amber:0x344A58),0);
+    }
+    lv_label_set_text_fmt(_traffic,"TX %lu     RX %lu",(unsigned long)s.tx_packets,(unsigned long)s.rx_packets);
+    esp_netif_t *netif=esp_netif_get_handle_from_ifkey("AX900");
+    esp_netif_ip_info_t info={};esp_netif_dns_info_t dns={};
+    bool has_ip=s.has_ip && netif && esp_netif_get_ip_info(netif,&info)==ESP_OK;
+    if(has_ip) {
+        lv_label_set_text_fmt(_addresses[0],IPSTR,IP2STR(&info.ip));
+        lv_label_set_text_fmt(_addresses[1],IPSTR,IP2STR(&info.gw));
+        lv_label_set_text_fmt(_addresses[2],IPSTR,IP2STR(&info.netmask));
+        if(esp_netif_get_dns_info(netif,ESP_NETIF_DNS_MAIN,&dns)==ESP_OK && dns.ip.type==ESP_IPADDR_TYPE_V4 && dns.ip.u_addr.ip4.addr)
+            lv_label_set_text_fmt(_addresses[3],IPSTR,IP2STR(&dns.ip.u_addr.ip4));
+        else lv_label_set_text(_addresses[3],"Not provided");
+    } else for(auto *field:_addresses)lv_label_set_text(field,"--");
+
+    ax900_probe_result_t p;ax900_probe_get_result(&p);
+    bool running=p.state==AX900_PROBE_RUNNING,stale=p.state==AX900_PROBE_STALE;
+    if(has_ip && !running)lv_obj_remove_state(_button,LV_STATE_DISABLED);
+    else lv_obj_add_state(_button,LV_STATE_DISABLED);
+    lv_label_set_text(_buttonLabel,running?"Testing...":"Run test");
+    bool measured=p.state!=AX900_PROBE_IDLE && !stale && !p.error;
+    uint32_t color=p.state==AX900_PROBE_PASSED?green:p.state==AX900_PROBE_PARTIAL?amber:ink;
+    if(!has_ip)lv_label_set_text(_headline,"Connect to Wi-Fi first");
+    else if(stale)lv_label_set_text(_headline,"Connection changed");
+    else if(running)lv_label_set_text_fmt(_headline,"Testing %lu / %u",(unsigned long)p.sent,AX900_PROBE_COUNT);
+    else if(p.error)lv_label_set_text(_headline,"Could not start test");
+    else if(p.received)lv_label_set_text_fmt(_headline,"%lu ms  average",(unsigned long)p.average_ms);
+    else lv_label_set_text(_headline,p.state==AX900_PROBE_FAILED?"No gateway reply":"Ready to test");
+    lv_obj_set_style_text_color(_headline,lv_color_hex(color),0);
+    if(has_ip && measured && p.sent)
+        lv_label_set_text_fmt(_summary,"%lu / %lu replies   |   %lu%% loss   |   min %lu / max %lu ms",
+            (unsigned long)p.received,(unsigned long)p.sent,(unsigned long)((p.sent-p.received)*100/p.sent),(unsigned long)p.min_ms,(unsigned long)p.max_ms);
+    else if(stale)lv_label_set_text(_summary,"Run a new test for the current connection.");
+    else if(p.error && has_ip)lv_label_set_text(_summary,esp_err_to_name(p.error));
+    else lv_label_set_text(_summary,"5 requests  /  latency and packet loss");
+    lv_bar_set_value(_progress,measured && has_ip?p.sent:0,LV_ANIM_OFF);
+    for(unsigned i=0;i<AX900_PROBE_COUNT;i++) {
+        int32_t rtt=measured && has_ip?p.rtt_ms[i]:-1;
+        if(rtt>=0)lv_label_set_text_fmt(_samples[i],"%ld ms",(long)rtt);
+        else lv_label_set_text(_samples[i],rtt==-2?"Timeout":"--");
+        lv_obj_set_style_text_color(_samples[i],lv_color_hex(rtt>=0?green:rtt==-2?amber:muted),0);
+        lv_obj_center(_samples[i]);
+    }
+}
+#endif
diff --git a/platforms/tab5/main/ax900_console.cpp b/platforms/tab5/main/ax900_console.cpp
new file mode 100644
--- /dev/null
+++ b/platforms/tab5/main/ax900_console.cpp
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: MIT
+// Local USB diagnostic commands for repeatable hardware and display verification.
+#include <ax900.h>
+#include <ax900_probe.h>
+#include <hal/hal.h>
+#include <lvgl.h>
+#include <unistd.h>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <esp_netif.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/task.h>
+#include <hal/components/tab5_keyboard.h>
+extern void ax900_ui_request_open();
+extern void ax900_ui_request_select(const char *ssid);
+extern bool ax900_ui_can_snapshot();
+
+extern void ax900_ui_request_test(bool run);
+static void probe_status() {
+    ax900_probe_result_t p;ax900_probe_get_result(&p);
+    printf("AX900_PROBE state=%u sent=%lu received=%lu avg_ms=%lu min_ms=%lu max_ms=%lu elapsed_ms=%lu error=%d\n",
+        p.state,(unsigned long)p.sent,(unsigned long)p.received,(unsigned long)p.average_ms,
+        (unsigned long)p.min_ms,(unsigned long)p.max_ms,(unsigned long)p.elapsed_ms,p.error);
+}
+
+static void snapshot() {
+    lv_draw_buf_t *buffer;
+    {LvglLockGuard lock;if(!ax900_ui_can_snapshot()){printf("AXSNAP BLOCKED credential dialog\n");return;}buffer=lv_snapshot_take(lv_screen_active(),LV_COLOR_FORMAT_RGB565);}
+    if(!buffer){printf("AXSNAP ERROR allocation\n");return;}
+    const unsigned width=buffer->header.w,height=buffer->header.h;
+    std::unique_ptr<char[]> line(new(std::nothrow) char[width*6+1]);
+    if(!line){lv_draw_buf_destroy(buffer);return;}
+    printf("AXSNAP BEGIN %u %u RGB565-RLE\n",width,height);
+    constexpr char hex[]="0123456789abcdef";
+    for(unsigned y=0;y<height;y++) {
+        const auto *row=reinterpret_cast<const uint16_t *>(buffer->data+y*buffer->header.stride);
+        size_t pos=0;
+        for(unsigned x=0;x<width;) {
+            uint16_t color=row[x];unsigned count=1;
+            while(count<255 && x+count<width && row[x+count]==color)count++;
+            uint8_t bytes[]={static_cast<uint8_t>(count),static_cast<uint8_t>(color),static_cast<uint8_t>(color>>8)};
+            for(auto b:bytes){line[pos++]=hex[b>>4];line[pos++]=hex[b&15];}
+            x+=count;
+        }
+        line[pos]=0;printf("AXSNAP ROW %u %s\n",y,line.get());
+        if(y%8==0)vTaskDelay(1);
+    }
+    printf("AXSNAP END\n");lv_draw_buf_destroy(buffer);
+}
+void ax900_console_poll() {
+    static char command[48];static size_t used=0;
+    // The default USB Serial/JTAG VFS uses non-blocking hardware reads already.
+    // O_NONBLOCK would skip its one-byte prefetch when no ring-buffer driver exists.
+    char input[64];ssize_t n=read(STDIN_FILENO,input,sizeof(input));
+    for(ssize_t i=0;i<n;i++) {
+        if(input[i]=='\n' || input[i]=='\r') {
+            command[used]=0;used=0;
+            if(!strcmp(command,"ax900 scan"))printf("AX900_SCAN_REQUEST %d\n",ax900_request_scan());
+            else if(!strcmp(command,"ax900 open"))ax900_ui_request_open();
+            else if(!strncmp(command,"ax900 select ",13))ax900_ui_request_select(command+13);
+            else if(!strncmp(command,"ax900 associate ",16)) {
+                auto s=std::make_unique<ax900_status_t>();ax900_get_status(s.get());
+                const ax900_ap_t *best=nullptr;unsigned frequency=0;int offset=0;
+                const char *ssid=command+16;
+                if(sscanf(ssid,"%u %n",&frequency,&offset)==1 && offset>0)ssid+=offset;
+                else frequency=0;
+                for(size_t j=0;j<s->ap_count;j++)if(!strcmp(s->aps[j].ssid,ssid) && s->aps[j].frequency>5000 && (!frequency || s->aps[j].frequency==frequency) && (!best || s->aps[j].rssi>best->rssi))best=&s->aps[j];
+                printf("AX900_ASSOCIATE_TEST %d\n",best?ax900_test_association(best):ESP_ERR_NOT_FOUND);
+            }
+            else if(!strcmp(command,"ax900 probe"))printf("AX900_PROBE_START %d\n",ax900_probe_start());
+            else if(!strcmp(command,"ax900 test"))ax900_ui_request_test(false);
+            else if(!strcmp(command,"ax900 test-run"))ax900_ui_request_test(true);
+            else if(!strcmp(command,"ax900 test-status"))probe_status();
+            else if(!strcmp(command,"ax900 keyboard")){LvglLockGuard lock;printf("TAB5_KEYBOARD connected=%u\n",tab5_keyboard_connected());}
+            else if(!strcmp(command,"ax900 disconnect"))printf("AX900_DISCONNECT %d\n",ax900_disconnect());
+            else if(!strcmp(command,"ax900 snapshot"))snapshot();
+            else if(!strcmp(command,"ax900 status")) {
+                auto s=std::make_unique<ax900_status_t>();ax900_get_status(s.get());
+                unsigned band5=0;for(size_t j=0;j<s->ap_count;j++)band5+=s->aps[j].frequency>5000;
+                printf("AX900_STATUS ready=%d supports5=%d scanning=%d generation=%lu APs=%u band5=%u status=%s\n",
+                    s->ready,s->supports_5ghz,s->scanning,static_cast<unsigned long>(s->scan_generation),static_cast<unsigned>(s->ap_count),band5,s->status);
+                printf("AX900_LINK connecting=%d associated=%d authenticated=%d has_ip=%d ip=%s tx=%lu rx=%lu dropped=%lu reason=%u\n",
+                    s->connecting,s->associated,s->authenticated,s->has_ip,s->ip,
+                    static_cast<unsigned long>(s->tx_packets),static_cast<unsigned long>(s->rx_packets),
+                    static_cast<unsigned long>(s->rx_dropped),s->disconnect_reason);
+                printf("AX900_SAVED count=%u current=%u error=%d\n",s->saved_networks,s->credentials_saved,s->profile_error);
+            }
+        } else if(used<sizeof(command)-1)command[used++]=input[i];
+    }
+}
